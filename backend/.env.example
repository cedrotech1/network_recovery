PORT=9500
HOST=127.0.0.1
NODE_ENV=development

CORS_ORIGINS=http://localhost:5473,http://localhost:3000,http://127.0.0.1:5473,http://127.0.0.1:3000
CORS_ALLOW_LAN=1

RATE_LIMIT_AUTH_MAX=50
RATE_LIMIT_API_MAX=2000

# PostgreSQL + Sequelize
DEV_DATABASE_NAME=network_recovery
DEV_DATABASE_USER=postgres
DEV_DATABASE_PASSWORD=your_password
DEV_DATABASE_HOST=127.0.0.1
DEV_DATABASE_PORT=5432

PRO_DATABASE_NAME=network_recovery
PRO_DATABASE_USER=postgres
PRO_DATABASE_PASSWORD=your_password
PRO_DATABASE_HOST=127.0.0.1
PRO_DATABASE_PORT=5432

UAT_DATABASE_NAME=network_recovery_uat
UAT_DATABASE_USER=postgres
UAT_DATABASE_PASSWORD=your_password
UAT_DATABASE_HOST=127.0.0.1
UAT_DATABASE_PORT=5432

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

APP_URL=http://localhost:5473
FRONTEND_URL=http://localhost:5473
